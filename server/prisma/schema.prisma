datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id
  name      String
  email     String   @unique

  documents Document[]

  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(uuid())

  title     String
  content   String

  ownerId   String

  owner     User @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}